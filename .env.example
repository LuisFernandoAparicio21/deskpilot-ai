# Plantilla de variables de entorno de DeskPilot AI.
# Copia este archivo a .env (ignorado por git) y llena solo lo que uses. Nunca subas .env.

# --- Aplicación ---
# Clave que deben enviar los clientes en el header X-API-Key. Genera una con:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
DESKPILOT_API_KEY=
# Modo de datos: local (SQLite) | fabric (Microsoft Fabric). Sobrescribe app.mode de config.yaml.
DESKPILOT_MODE=local

# --- LLM (opcional; con none se responde de forma extractiva con cita) ---
# Proveedor: none | anthropic | openai | gemini. Sobrescribe llm.provider de config.yaml.
LLM_PROVIDER=none
# Clave de la API de Anthropic (solo si LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Clave de la API de OpenAI (solo si LLM_PROVIDER=openai).
OPENAI_API_KEY=
# Clave de la API de Gemini (solo si LLM_PROVIDER=gemini).
GEMINI_API_KEY=

# --- Microsoft Fabric (solo modo fabric) ---
# Host del SQL analytics endpoint del lakehouse (lectura), p. ej. <id>.datawarehouse.fabric.microsoft.com
FABRIC_SQL_ENDPOINT=
# Nombre del lakehouse (base de datos) en el SQL analytics endpoint.
FABRIC_LAKEHOUSE_DATABASE=
# Host del Warehouse de Fabric donde crear_ticket escribe (dbo.tickets_nuevos).
FABRIC_WAREHOUSE_ENDPOINT=
# Nombre del Warehouse (base de datos).
FABRIC_WAREHOUSE_DATABASE=

# --- Autenticación con Microsoft Entra ID (service principal, solo modo fabric) ---
# ID del tenant (directorio) de Entra ID.
AZURE_TENANT_ID=
# ID de la aplicación (client ID) del service principal.
AZURE_CLIENT_ID=
# Secreto del service principal. Nunca lo compartas ni lo subas.
AZURE_CLIENT_SECRET=
